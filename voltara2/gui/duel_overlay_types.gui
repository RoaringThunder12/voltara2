	type injury_risk_widget_right = injury_risk_widget {
		blockoverride "value" {
			value = "[FixedPointToFloat(GuiScope.SetRoot(EventWindowData.GetPortraitCharacter('right_portrait').MakeScope).ScriptValue('sc_defender_injury_check_grey'))]"
		}
		blockoverride "value_red" {
			value = "[FixedPointToFloat(GuiScope.SetRoot(EventWindowData.GetPortraitCharacter('right_portrait').MakeScope).ScriptValue('sc_defender_injury_check_UI'))]"
		}
		blockoverride "w_1" {
			visible = "[LessThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(EventWindowData.GetPortraitCharacter('right_portrait').MakeScope).ScriptValue('sc_defender_injury_check_UI'), '(CFixedPoint)0.0')]"
		}
		blockoverride "w_1_not" {
			visible = "[GreaterThan_CFixedPoint(GuiScope.SetRoot(EventWindowData.GetPortraitCharacter('right_portrait').MakeScope).ScriptValue('sc_defender_injury_check_UI'), '(CFixedPoint)0.0')]"
		}
		blockoverride "glow1" {
			visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(EventWindowData.GetPortraitCharacter('right_portrait').MakeScope).ScriptValue('sc_defender_injury_check_UI'), '(CFixedPoint)0.2')]"
		}
		blockoverride "glow2" {
			visible = "[GreaterThan_CFixedPoint(GuiScope.SetRoot(EventWindowData.GetPortraitCharacter('right_portrait').MakeScope).ScriptValue('sc_defender_injury_check_UI'), '(CFixedPoint)0.2')]"
		}
	}

	type event_settings = widget {
		position = { -70 60 }
		size = { 400 80 }
		allow_outside = yes
		alwaystransparent = no

		#onmousehierarchyenter = "[PdxGuiInterruptThenTriggerAllAnimations('b', 'show_event_settings')]"
		onmousehierarchyenter = "[PdxGuiInterruptThenTriggerAllAnimations('c', 'show_event_settings')]"
		onmousehierarchyleave = "[PdxGuiTriggerAllAnimations('c')]"
		parentanchor = right

		flowcontainer = {
			alwaystransparent = no
			# visible = "[GetVariableSystem.Exists('event_settings_strip')]"
			parentanchor = right
			state = {
				delay = 0.7
				name = c
				duration = 0.3
				alpha = 0
				on_finish = "[GetVariableSystem.Clear('event_settings_strip')]"
			}

			state = {
				name = show_event_settings
				alpha = 1
				on_finish = "[GetVariableSystem.Toggle('event_settings_strip')]"
			}

			direction = vertical
			ignoreinvisible = yes

			flowcontainer = {
				alwaystransparent = no
				parentanchor = right

				# background = {
				# 	using = Background_Area_Light
				# 	visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				# 	margin = { -20 -20 }
				# 	margin_right = -25
				# }

				ignoreinvisible = yes
				spacing = 7
				margin = { 0 20 }
				alpha = 0.6

				flowcontainer = {
					name = "debug_stuff"
					visible = "[InDebugMode]"
					ignoreinvisible = yes

					button_round = {
						alwaystransparent = no
						tooltip = "REGENERATE_EVENT_CONTENTS"
						using = tooltip_below

						using = Animation_ShowHide_Quick
						onclick = "[EventWindow.ResetContents]"

						button_replace = {
							parentanchor = center
							alwaystransparent = yes
						}
					}

					button_round = {
						size = { 40 40 }

						button_icon = {
							size = { 100% 100% }
							texture = "gfx/interface/icons/flat_icons/data_system.dds"
							tooltip = "TOGGLE_DATA_SYSTEM"
							using = tooltip_below
							onclick = "[ExecuteConsoleCommand('Localization.ToggleSkipDataSystemInLocOutput')]"
							fontsize = 24
						}
					}

					button_round = {
						size = { 40 40 }
						button_copy = {
							parentanchor = center
							onclick = "[EventWindowData.CopyToClipboard]"
							tooltip = "COPY_EVENT_CONTENTS"
						}
					}

					container = {
						tooltip = "[EventWindowData.GetTriggerBreakdown]"
						using = tooltip_below
						icon = {
							visible = "[EventWindowData.IsTriggerFulfilled]"
							size = { 40 40 }
							texture = "gfx/interface/icons/symbols/icon_check.dds"
						}

						icon = {
							visible = "[Not( EventWindowData.IsTriggerFulfilled )]"
							size = { 40 40 }
							texture = "gfx/interface/icons/symbols/icon_cross.dds"
						}
					}

					button = {
						name = "debug_icon"
						size = { 40 40 }

						button = {
							size = { 100% 100% }
							tooltip = "[EventWindowData.GetDebugInfo]"
							using = tooltip_below
							onclick = "[EventWindowData.CopyToClipboard]"
							onrightclick = "[EventWindowData.DebugOpen]"
							button_ignore = none
							raw_text = "?"
							fontsize = 24
						}
					}
				}

				button_menu = {
					size = { 40 40 }
					#tooltip = "settings"

					onclick = "[GetVariableSystem.Toggle('event_settings')]"
					#using = tooltip_ne
				}
			}

			flowcontainer = {
				visible = "[GetVariableSystem.Exists('event_settings')]"
				direction = vertical
				alwaystransparent = no
				margin_bottom = 5

				onmousehierarchyleave = "[GetVariableSystem.Clear('event_settings')]"

				background = {
					margin = { 10 10 }
					using = Background_Area_Light
					alpha = 0.8
				}

				minimumsize = { 330 0 }

				event_settings_button = {
					datacontext = "[GetScriptedGui('boardgame_overlay')]"

					blockoverride "text" {
						text = "boardgame_overlay"
						max_width = 280
					}

					blockoverride "checked" {
						checked = "[Not(GetPlayer.MakeScope.Var('boardgame_overlay').IsSet)]"
					}
				}

				button_standard = {
					size = { 100% 32 }
					datacontext = "[GetScriptedGui('extra_duel_info')]"
					onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					button_checkbox_label = {
						alwaystransparent = yes
						position = { 1 1 }

						blockoverride "text" {
							text = "duel_score"
							max_width = 280
						}

						blockoverride "checkbox" {
							alwaystransparent = yes
							checked = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}

				button_standard = {
					size = { 100% 32 }
					datacontext = "[GetScriptedGui('duel_icons')]"
					onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					button_checkbox_label = {
						alwaystransparent = yes
						position = { 1 1 }
						tooltip = "duel_icons_tt"

						blockoverride "text" {
							text = "duel_icons"
							max_width = 280
						}

						blockoverride "checkbox" {
							alwaystransparent = yes
							checked = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}
			}
		}
	}

	type event_settings_button = button_standard {
		size = { 100% 32 }
		# datacontext = "[GetScriptedGui('nameplates')]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

		button_checkbox_label = {
			alwaystransparent = yes
			position = { 1 1 }

			blockoverride "checkbox" {
				alwaystransparent = yes
				block "checked" {
					checked = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}
	}
}
