										margin_left = 2
										layoutpolicy_horizontal = expanding
										text = ansf_asexual
										default_format = "#clickable"
									}
								}
							}
						}
					}
				}
				
				hbox = {
					margin_top = 20
					button_primary = {
						size = { 120 30 }
						text = ansf_return_main_menu
						onclick = "[GetScriptedGui('ansf_clear_current_trait').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
						onclick = "[GetVariableSystem.Toggle('ansf_trait_window')]"
					}
				}
			}
		}
	}

}

types ansf_trait_menu_types
{

	type vbox_ansf_trait_start = vbox
	{
		spacing = 3

		item = {
			hbox = {
				datacontext = "[Scope.Trait]"
				layoutpolicy_horizontal = expanding
				block "test_visible"
				{
					visible = "[GetScriptedGui('ansf_current_trait').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('trait', Trait.MakeScope).End)]"
				}
				button_standard_hover = {
					name = "trait_item"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					size = { 0 30 }
					onclick = "[GetScriptedGui('ansf_current_trait').Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('trait', Trait.MakeScope).End)]"
					button_ignore = none

					hbox = {
						margin = { 5 0 }
						margin_right = 10
						spacing = 10

						icon_trait = {
							blockoverride "faith_context"
							{
								datacontext = "[Character.GetFaith]"
								datacontext = "[Character.GetRite]"
							}
							blockoverride "tooltip_placement"
							{
								using = tooltip_ws
							}
							blockoverride "icon_size"
							{
								size = { 30 30 }
							}
						}
						
						background = {
							name = "interaction_glow"
							visible = "[GetScriptedGui('ansf_highlight_current_trait').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('trait', Trait.MakeScope).End)]"
							texture = "gfx/interface/component_tiles/tile_selected.dds"
							spriteType = corneredtiled
							spriteborder = { 30 30 }
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "[Trait.GetNameNoTooltip( Character.Self )]"
							default_format = "#clickable"
						}
						
					}
				}
			}
		}
	}

	type vbox_ansf_trait_selection = vbox
	{
		spacing = 3

		item = {
			hbox = {
				datacontext = "[Scope.Trait]"
				layoutpolicy_horizontal = expanding
				block "test_visible"
				{
					visible = "[And( Not( GetScriptedGui('ansf_current_trait').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('trait', Trait.MakeScope).End) ), GetScriptedGui('ansf_is_valid_gui_trait').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('trait', Trait.MakeScope).End) )]"
				}
				button_standard_hover = {
					name = "trait_item"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					size = { 0 30 }
					onclick = "[GetScriptedGui('ansf_change_trait').Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('trait', Trait.MakeScope).End)]"
					button_ignore = none
					tooltip = ansf_replace_trait_tt

					hbox = {
						margin = { 5 0 }
						margin_right = 10
						spacing = 10

						icon_trait = {
							blockoverride "faith_context"
							{
								datacontext = "[Character.GetFaith]"
								datacontext = "[Character.GetRite]"
							}
							blockoverride "tooltip_placement"
							{
								using = tooltip_ws
							}
							blockoverride "icon_size"
							{
								size = { 30 30 }
							}
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "[Trait.GetNameNoTooltip( Character.Self )]"
							default_format = "#clickable"
						}
						
					}
				}
			}
		}
	}
}

