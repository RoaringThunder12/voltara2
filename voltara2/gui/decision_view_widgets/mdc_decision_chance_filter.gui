# Native button_group/radio/text presentation with no intrinsic content measurement.
types MdcFixedRecipientRows
{
    type mdc_fixed_recipient_option = button_group {
        using = tooltip_se
        size = { 470 30 }
        minimumsize = { 470 30 }
        maximumsize = { 470 30 }
        widget = {
            name = "mdc_recipient_fixed_body"
            size = { 320 30 }
            minimumsize = { 320 30 }
            maximumsize = { 320 30 }
            parentanchor = top|left
            widgetanchor = top|left
            position = { 75 0 }
            button_radio = {
                size = { 30 30 }
                minimumsize = { 30 30 }
                maximumsize = { 30 30 }
                parentanchor = top|left
                widgetanchor = top|left
                position = { 0 0 }
                block "radio" {}
                background = {
                    texture = "gfx/interface/buttons/button_round_big.dds"
                    alpha = 0.5
                }
            }
            text_single = {
                size = { 285 30 }
                minimumsize = { 285 30 }
                maximumsize = { 285 30 }
                parentanchor = top|left
                widgetanchor = top|left
                position = { 35 0 }
                autoresize = no
                align = left|nobaseline
                default_format = "#clickable"
                alwaystransparent = yes
                block "text" { text = "DEFAULT_TEXT" }
            }
        }
    }
}
