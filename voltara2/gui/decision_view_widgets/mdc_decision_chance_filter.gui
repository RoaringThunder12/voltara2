# Required controller: decision_option_list_controller.
# Only display state uses VariableSystem; OnSelect transmits the native item flag.
# All eleven registered entries must remain present and in their documented order.
vbox = {
    ignoreinvisible = yes
    name = "mdc_decision_chance_filter"
    layoutpolicy_horizontal = expanding
    minimumsize = { 514 250 }
    maximumsize = { 514 250 }
    spacing = 8
    state = {
        name = mdc_initialize_on_create
        trigger_on_create = yes
        on_start = "[GetVariableSystem.Set('mdc_conversion_filter_ui', 'none')]"
    }
    state = {
        name = _show
        on_start = "[GetVariableSystem.Set('mdc_conversion_filter_ui', 'none')]"
    }
    state = {
        name = _hide
        on_start = "[GetVariableSystem.Clear('mdc_conversion_filter_ui')]"
    }
    # Absolute filter controls: both parent and own origins are explicitly top-left.
    # Datamodel widget items overlay; only the selected group's item is visible.
    widget = {
        name = "mdc_filter_row"
        size = { 514 32 }
        minimumsize = { 514 32 }
        maximumsize = { 514 32 }
        widget = {
            name = "mdc_native_default_reset"
            size = { 0 0 }
            alwaystransparent = yes
            datamodel = "[DataModelSkipFirst( DataModelFirst( DecisionViewWidgetOptionList.GetEntries, '(int32)1' ), '(int32)0' )]"
            item = {
                widget = {
                    size = { 0 0 }
                    state = {
                        name = mdc_select_default_on_create
                        trigger_on_create = yes
                        on_start = "[DecisionViewWidgetOptionList.OnSelect(Entry.Self)]"
                    }
                    # Covers a reused widget when the native window propagates _show.
                    state = {
                        name = _show
                        on_start = "[DecisionViewWidgetOptionList.OnSelect(Entry.Self)]"
                    }
                }
            }
        }
        widget = {
            parentanchor = top|left
            widgetanchor = top|left
            position = { 0 0 }
            size = { 514 32 }
            datamodel = "[DataModelSkipFirst( DataModelFirst( DecisionViewWidgetOptionList.GetEntries, '(int32)3' ), '(int32)0' )]"
            item = {
                widget = {
                    name = "mdc_filter_for_direct_vassals"
                    visible = "[Entry.IsSelected]"
                    parentanchor = top|left
                    widgetanchor = top|left
                    position = { 0 0 }
                    size = { 514 32 }
                    text_single = {
                        parentanchor = top|left
                        widgetanchor = top|left
                        position = { 0 0 }
                        size = { 120 30 }
                        align = left|nobaseline
                        using = Font_Size_Small
                        text = "mdc_chance_filter_heading"
                        tooltip = "mdc_chance_filter_tooltip"
                    }
                    vbox = {
                        parentanchor = top|left
                        widgetanchor = top|left
                        position = { 122 0 }
                        size = { 125 30 }
                        ignoreinvisible = yes
                        minimumsize = { 125 30 }
                        maximumsize = { 125 30 }
                        datamodel = "[DataModelSkipFirst( DataModelFirst( DecisionViewWidgetOptionList.GetEntries, '(int32)1' ), '(int32)0' )]"
                        item = {
                            button_radio_label = {
                                name = "mdc_filter_target_0_none"
                                size = { 125 30 }
                                onclick = "[DecisionViewWidgetOptionList.OnSelect(Entry.Self)]"
                                onclick = "[GetVariableSystem.Set('mdc_conversion_filter_ui', 'none') ]"
                                tooltip = "mdc_chance_filter_tooltip"
                                blockoverride "radio" {
                                    frame = "[BoolTo1And2(Not(Or(GetVariableSystem.HasValue('mdc_conversion_filter_ui', '80'), GetVariableSystem.HasValue('mdc_conversion_filter_ui', '100'))))]"
                                }
                                blockoverride "text" { text = "mdc_chance_filter_none" }
