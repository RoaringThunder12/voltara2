								}
							}
						}
					}
				}
			}
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin_top = 10
			spacing = 5
			background = {
				using = Background_Area_Dark
			}
			background = {
				texture = "[Accolade.GetOwner.GetCulture.GetGraphicalUnitType.GetAccoladesBigIllustration]"
				fittype = centercrop
				using = Mask_Rough_Edges
				alpha = 0.7
				modify_texture = {
					texture = "[Select_CString( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'gfx/interface/component_masks/mask_edge_3px.dds', 'gfx/interface/component_masks/mask_holding_illustration.dds' )]"
					blend_mode = alphamultiply
					alpha = 0.95
				}
			}
			text_single = {
				text = "ACCOLADE_SQUIRE_STATUS"
				default_format = "#medium;glow_color:{0,0,0,1}"
				margin_bottom = 5
				max_width = 450
				using = Font_Size_Medium
				align = center
				tooltip = "[AccoladeView.GetAccoladeSquireQualityBreakdown]"
				background = {
					margin = { 70 0 }
					texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
					spriteType = Corneredtiled
					spriteborder = { 40 8 }
					texture_density = 2
					modify_texture = {
						name = "mask"
						texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = alphamultiply
					}
				}
			}
			expand = {}
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 0 15 }
			margin_top = "[Select_int32( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), '(int32)6', '(int32)15' )]"
			margin_bottom = "[Select_int32( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), '(int32)6', '(int32)15' )]"
			spacing = 15
			expand = {}
			datacontext = "[AccoladeView.GetAccolade]"
			button_standard = {
				size = { 200 32 }
				text = "ACCOLADE_HISTORY"
				tooltip = "SHOW_ACCOLADE_HISTORY"
				onclick = "[AccoladeView.ToggleHistory]"
			}
			button_standard = {
				size = { 200 32 }
				text = "RETIRE_ACCOLADE"
				tooltip = "RETIRE_ACCOLADE_TT"
				onclick = "[GetScriptedGui( 'miv_accolade_artifact_recall_all' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).End )]"
				onclick = "[Accolade.DestroyAccolade]"
			}
			expand = {}
		}
	}
	vbox = {
		datacontext = "[AccoladeView.GetAccolade]"
		visible = "[AccoladeView.IsShowingHistory]"
		margin = { 4 4 }
		spacing = 5
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "ACCOLADE_HISTORY"
			}
			blockoverride "button_close" {
				onclick = "[AccoladeView.ToggleHistory]"
				texture = "gfx/interface/icons/flat_icons/window_back.dds"
				tooltip = "BACK_TOOLTIP"
			}
		}
		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_content" {
				vbox = {
					name = "accolade_history_entries"
					datamodel = "[Accolade.GetHistory]"
					layoutpolicy_horizontal = expanding
					spacing = 10
					item = {
						hbox = {
							datacontext = "[AccoladeHistoryEntry.GetAcclaimedKnight]"
							layoutpolicy_horizontal = expanding
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 10
								margin = { 0 0 }
								hbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									spacing = 10
									portrait_head = {}
									vbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										spacing = 10
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 10
											background = {
												texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
												spriteType = Corneredtiled
												spriteborder = { 40 8 }
												texture_density = 2
												modify_texture = {
													name = "mask"
													texture = "gfx/interface/component_masks/mask_fade_horizontal_extended.dds"
													spriteType = Corneredstretched
													spriteborder = { 0 0 }
													blend_mode = alphamultiply
												}
											}
											widget = {
												size = { 30 50 }
												icon = {
													parentanchor = center
													texture = "gfx/interface/icons/icon_knight_acclaimed.dds"
													size = { 50 50 }
												}
											}
											text_single = {
												text = "[Character.GetNameNoTooltip]"
												align = nobaseline
												using = Font_Size_Medium
												max_width = 185
											}
											expand = {}
											text_single = {
												text = "[prowess_i][Character.GetSkill( 'prowess' )]"
												align = nobaseline
												default_format = "#high"
												using = Font_Size_Big
											}
										}
										text_multi = {
											layoutpolicy_horizontal = expanding
											text = "ACCOLADE_HISTORY_ENTRY_DATE"
											autoresize = yes
											max_width = 280
										}
										expand = {}
									}
								}
								divider = {
									layoutpolicy_horizontal = expanding
								}
							}
						}
					}
				}
			}
		}
	}
	widget = {
		name = "miv_accolade_artifact_equipment"
		size = { 90 224 }
		position = { 8 118 }
		visible = "[And( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( Not( AccoladeView.IsShowingHistory ), Not( GetVariableSystem.Exists( 'miv_accolade_artifact_picker' ) ) ) )]"
		vbox = {
			spacing = 4
			vbox = {
				ignoreinvisible = yes
				spacing = 2
				text_single = {
					size = { 90 20 }
					autoresize = no
					align = center|nobaseline
					using = Font_Size_Small
					text = "artifact_slot_primary_armament"
					alwaystransparent = yes
				}
				button_standard = {
					name = "miv_accolade_artifact_weapon_slot"
					size = { 64 64 }
					blockoverride "button_pattern" {}
					enabled = "[And( AccoladeView.GetAccolade.GetOwner.IsLocalPlayer, AccoladeView.GetAccolade.GetAcclaimedKnight.IsValid )]"
					tooltip = "miv_accolade_artifact_choose_weapon"
					onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_weapon_picker' )]"
					onclick = "[GetVariableSystem.Set( 'miv_accolade_artifact_weapon_picker', 'open' )]"
					onclick = "[GetVariableSystem.Set( 'miv_accolade_artifact_picker', 'open' )]"
					button_icon = {
						size = { 30 30 }
						parentanchor = center
						alwaystransparent = yes
						visible = "[Not( AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_weapon_artifact' ).IsSet )]"
						texture = "gfx/interface/icons/flat_icons/plus.dds"
					}
					widget = {
						size = { 60 60 }
						parentanchor = center
						alwaystransparent = yes
						visible = "[AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_weapon_artifact' ).IsSet]"
						datacontext = "[AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_weapon_artifact' ).Artifact]"
						icon = {
							size = { 60 60 }
							parentanchor = center
							alwaystransparent = yes
							texture = "gfx/interface/icons/artifact/artifact_bg.dds"
							frame = "[Artifact.GetIconFrame]"
							framesize = { 240 240 }
						}
						icon = {
							size = { 60 60 }
							parentanchor = center
							alwaystransparent = yes
							visible = "[Artifact.IsUnique]"
							texture = "gfx/interface/icons/artifact/artifact_unique.dds"
						}
						icon = {
							size = { 54 54 }
							parentanchor = center
							alwaystransparent = yes
							texture = "[Artifact.GetIcon]"
							frame = "[Artifact.GetIconFrame]"
							framesize = { 240 240 }
						}
					}
				}
				button_tertiary = {
					name = "miv_accolade_artifact_recall_weapon"
					size = { 70 21 }
					visible = "[AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_weapon_artifact' ).IsSet]"
					enabled = "[GetScriptedGui( 'miv_accolade_artifact_recall_weapon' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).End )]"
					onclick = "[GetScriptedGui( 'miv_accolade_artifact_recall_weapon' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).End )]"
					tooltip = "miv_accolade_artifact_recall_tt"
					text = "miv_accolade_artifact_recall"
					using = Font_Size_Small
				}
			}
			vbox = {
				ignoreinvisible = yes
				spacing = 2
				text_single = {
					size = { 90 20 }
					autoresize = no
					align = center|nobaseline
					using = Font_Size_Small
					text = "artifact_slot_armor"
					alwaystransparent = yes
				}
				button_standard = {
					name = "miv_accolade_artifact_armor_slot"
					size = { 64 64 }
					blockoverride "button_pattern" {}
					enabled = "[And( AccoladeView.GetAccolade.GetOwner.IsLocalPlayer, AccoladeView.GetAccolade.GetAcclaimedKnight.IsValid )]"
					tooltip = "miv_accolade_artifact_choose_armor"
					onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_weapon_picker' )]"
					onclick = "[GetVariableSystem.Set( 'miv_accolade_artifact_picker', 'open' )]"
					button_icon = {
						size = { 30 30 }
						parentanchor = center
						alwaystransparent = yes
						visible = "[Not( AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_armor_artifact' ).IsSet )]"
						texture = "gfx/interface/icons/flat_icons/plus.dds"
					}
					widget = {
						size = { 60 60 }
						parentanchor = center
						alwaystransparent = yes
						visible = "[AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_armor_artifact' ).IsSet]"
						datacontext = "[AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_armor_artifact' ).Artifact]"
						icon = {
							size = { 60 60 }
							parentanchor = center
							alwaystransparent = yes
							texture = "gfx/interface/icons/artifact/artifact_bg.dds"
							frame = "[Artifact.GetIconFrame]"
							framesize = { 240 240 }
						}
						icon = {
							size = { 60 60 }
							parentanchor = center
							alwaystransparent = yes
							visible = "[Artifact.IsUnique]"
							texture = "gfx/interface/icons/artifact/artifact_unique.dds"
						}
						icon = {
							size = { 54 54 }
							parentanchor = center
							alwaystransparent = yes
							texture = "[Artifact.GetIcon]"
							frame = "[Artifact.GetIconFrame]"
							framesize = { 240 240 }
						}
					}
				}
				button_tertiary = {
					name = "miv_accolade_artifact_recall_armor"
					size = { 70 21 }
					visible = "[AccoladeView.GetAccolade.MakeScope.Var( 'miv_accolade_artifact_armor_artifact' ).IsSet]"
					enabled = "[GetScriptedGui( 'miv_accolade_artifact_recall_armor' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).End )]"
					onclick = "[GetScriptedGui( 'miv_accolade_artifact_recall_armor' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).End )]"
					tooltip = "miv_accolade_artifact_recall_tt"
					text = "miv_accolade_artifact_recall"
					using = Font_Size_Small
				}
			}
		}
	}
}

types

AccoladeWindowTypes {
	type accolade_type_box = hbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 8
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				block
				"name_text" {
					text = "[AccoladeType.GetName]"
				}
				align = nobaseline
			}
			text_single = {
				margin_left = 8
				layoutpolicy_horizontal = expanding
				block
				"subtitle_text" {
					text = ""
				}
				default_format = "#low"
				align = nobaseline
				max_width = 290
			}
		}
		block
		"icons" {}
		block
		"change_button" {}
	}
	type accolade_banner = icon {
		parentanchor = center
		size = { 98 103 }
		alwaystransparent = yes
		texture = "gfx/interface/icons/knight_badge/frame/accolade_frame.dds"
		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_horizontal_middle.dds"
			blend_mode = overlay
			alpha = 0.15
		}
	}
	type accolade_banner_dark = icon {
		parentanchor = center
		size = { 98 103 }
		alwaystransparent = yes
		texture = "gfx/interface/icons/knight_badge/frame/accolade_frame.dds"
		alpha = 0.3
	}
	type accolade_banner_broken = icon {
		parentanchor = center
		size = { 98 103 }
		alwaystransparent = yes
		texture = "gfx/interface/icons/knight_badge/frame/accolade_frame.dds"
		enabled = no
	}
	type accolade_rank_icon = icon {
		parentanchor = bottom|hcenter
		size = { 44 44 }
		icon = {
			position = { 1 13 }
			size = { 100% 100% }
			visible = "[Accolade.HasActiveEffects]"
			texture = "[Accolade.GetCurrentRankIcon]"
			tooltipwidget = accolade_tooltip
		}
	}
}
