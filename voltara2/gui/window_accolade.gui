window = {
	name = "accolade_view"
	size = { 480 770 }
	parentanchor = top|right
	position = { -630 170 }
	movable = no
	layer = middle
	datacontext = "[AccoladeView.AccessMilitaryView]"
	using = Window_Background_Subwindow
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		on_start = "[GetVariableSystem.Clear( 'miv_accolade_artifact_picker' )]"
		on_start = "[GetVariableSystem.Clear( 'miv_accolade_artifact_weapon_picker' )]"
		position_x = -630
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		position_x = -570
	}
	widget = {
		name = "miv_accolade_artifact_picker"
		size = { 470 760 }
		position = { 5 5 }
		visible = "[And( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( GetVariableSystem.Exists( 'miv_accolade_artifact_picker' ), Not( AccoladeView.IsShowingHistory ) ) )]"
		vbox = {
			size = { 470 760 }
			header_pattern = {
				size = { 470 55 }
				blockoverride "header_text" {
					text = "[SelectLocalization( GetVariableSystem.Exists( 'miv_accolade_artifact_weapon_picker' ), 'miv_accolade_artifact_choose_weapon', 'miv_accolade_artifact_choose_armor' )]"
					max_width = 345
				}
				blockoverride "header_text_placement" {
					parentanchor = vcenter|left
					position = { 10 -5 }
				}
				blockoverride "button_me" {
					visible = no
				}
				blockoverride "button_back" {
					tooltip = "BACK_TOOLTIP"
					onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_picker' )]"
					onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_weapon_picker' )]"
				}
				blockoverride "button_close" {
					tooltip = "CLOSE_TOOLTIP"
					onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_picker' )]"
					onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_weapon_picker' )]"
				}
			}
			text_multi = {
				size = { 430 95 }
				margin = { 20 10 }
				text = "miv_accolade_artifact_picker_hint"
				max_width = 430
				autoresize = no
				align = left|vcenter
				using = Font_Size_Medium
			}
			hbox = {
				name = "miv_accolade_artifact_list_container"
				size = { 446 610 }
				margin = { 12 0 }
				scrollbox = {
					name = "miv_accolade_artifact_list"
					size = { 446 610 }
					blockoverride "scrollbox_margins" {
						margin = { 8 8 }
						margin_right = 20
					}
					blockoverride "scrollbox_background_fade" {}
					blockoverride "scrollbox_content" {
						vbox = {
							size = { 418 0 }
							spacing = 6
							datamodel = "[GetPlayer.GetInventory.GetArtifacts]"
							item = {
								button_standard = {
									name = "miv_accolade_artifact_pick"
									size = { 418 84 }
									datacontext = "[Artifact]"
									blockoverride "button_pattern" {}
									visible = "[GetScriptedGui( Select_CString( GetVariableSystem.Exists( 'miv_accolade_artifact_weapon_picker' ), 'miv_accolade_artifact_weapon_candidate', 'miv_accolade_artifact_armor_candidate' ) ).IsShown( GuiScope.SetRoot( Artifact.MakeScope ).End )]"
									enabled = "[GetScriptedGui( 'miv_accolade_artifact_assign' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).AddScope( 'miv_accolade_artifact_artifact', Artifact.MakeScope ).End )]"
									tooltip = "[GetScriptedGui( 'miv_accolade_artifact_assign' ).BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).AddScope( 'miv_accolade_artifact_artifact', Artifact.MakeScope ).End )]"
									onclick = "[GetScriptedGui( 'miv_accolade_artifact_assign' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'miv_accolade_artifact_accolade', AccoladeView.GetAccolade.MakeScope ).AddScope( 'miv_accolade_artifact_artifact', Artifact.MakeScope ).End )]"
									onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_picker' )]"
									onclick = "[GetVariableSystem.Clear( 'miv_accolade_artifact_weapon_picker' )]"
									widget = {
										size = { 64 64 }
										position = { 10 10 }
										alwaystransparent = yes
										icon = {
											size = { 64 64 }
											parentanchor = center
											alwaystransparent = yes
											texture = "gfx/interface/icons/artifact/artifact_bg.dds"
											frame = "[Artifact.GetIconFrame]"
											framesize = { 240 240 }
										}
										icon = {
											size = { 64 64 }
											parentanchor = center
											alwaystransparent = yes
											visible = "[Artifact.IsUnique]"
											texture = "gfx/interface/icons/artifact/artifact_unique.dds"
										}
										icon = {
											size = { 58 58 }
											parentanchor = center
											alwaystransparent = yes
											texture = "[Artifact.GetIcon]"
											frame = "[Artifact.GetIconFrame]"
											framesize = { 240 240 }
										}
									}
									text_single = {
										position = { 86 10 }
										size = { 322 21 }
										autoresize = no
										max_width = 322
										align = left|nobaseline
										using = Font_Size_Small
										default_format = "#weak"
										text = "[Artifact.GetRarityAndSlotType]"
										alwaystransparent = yes
									}
									text_multi = {
										position = { 86 34 }
										size = { 322 42 }
										autoresize = no
										max_width = 322
										align = left|vcenter
										using = Font_Size_Medium
										default_format = "#high"
										text = "[Artifact.GetNameNoTooltip]"
										alwaystransparent = yes
									}
								}
							}
						}
					}
				}
			}
		}
	}
	vbox = {
		datacontext = "[AccoladeView.GetAccolade]"
		visible = "[And( Not( AccoladeView.IsShowingHistory ), Not( And( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetVariableSystem.Exists( 'miv_accolade_artifact_picker' ) ) ) )]"
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		margin = { 5 5 }
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "[Accolade.GetNameNoTooltip]"
				visible = "[Not( AccoladeView.IsRenaming )]"
				max_width = 360
			}
			blockoverride "header_text_placement" {
				parentanchor = vcenter|left
				position = { 10 -5 }
			}
			editbox_standard = {
				layoutpolicy_horizontal = expanding
				parentanchor = top|left
				size = { 380 30 }
				position = { 10 10 }
				visible = "[AccoladeView.IsRenaming]"
				blockoverride "editbox_properties" {
					name = "accolade_name"
					text = "[AccoladeView.GetTempName]"
					ontextedited = "[AccoladeView.EditName]"
					onreturnpressed = "[AccoladeView.SubmitName]"
				}
			}
			blockoverride "button_me" {
				texture = "gfx/interface/icons/flat_icons/edit_text.dds"
				tooltip = "RENAME_ACCOLADE"
				visible = "[Not( AccoladeView.IsRenaming )]"
				onclick = "[AccoladeView.ToggleRenaming]"
			}
			blockoverride "button_back" {
				onclick = "[AccoladeView.Close]"
				onclick = "[OpenGameView( 'knights' )]"
				tooltip = "BACK_TOOLTIP"
			}
			blockoverride "button_close" {
				onclick = "[AccoladeView.Close]"
				tooltip = "CLOSE_TOOLTIP"
			}
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			background = {
				margin_top = 10
				texture = "gfx/interface/illustrations/event_scenes/armory.dds"
				alpha = 0.6
				using = Mask_Rough_Edges
				fittype = centercrop
				modify_texture = {
					name = "mask"
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
					mirror = vertical
				}
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10
				margin_left = 10
				margin_right = 10
				background = {
					texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
					spriteType = Corneredtiled
					spriteborder = { 40 8 }
					texture_density = 2
					modify_texture = {
						name = "mask"
						texture = "gfx/interface/component_masks/mask_fade_horizontal_extended.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = alphamultiply
					}
				}
				hbox = {
					icon = {
						texture = "gfx/interface/icons/icon_knight_acclaimed.dds"
						size = { 50 50 }
					}
					text_single = {
						text = "[SelectLocalization( And( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetGlobalVariable( 'AGOT_is_loaded' ).IsSet ), 'ACCLAIMED_KNIGHT_NAME_DISPLAY', 'miv_accolade_artifact_acclaimed_knight_name' )]"
						align = left|nobaseline
						using = Font_Size_Medium
						max_width = 265
					}
				}
				vbox = {
					layoutpolicy_vertical = expanding
					margin_left = 5
					margin_top = 7
					margin_bottom = 7
					divider_light = {
						layoutpolicy_vertical = expanding
					}
				}
				text_single = {
					text = "[prowess_i][Accolade.GetAcclaimedKnight.GetSkill( 'prowess' )]"
					align = nobaseline
					default_format = "#high"
					using = Font_Size_Big
					max_width = 100
				}
				expand = {}
				button_round = {
					datacontext = "[Accolade.GetAcclaimedKnight]"
					visible = "[Not( Character.IsPlayer )]"
					tooltip = "ACCOLADE_VIEW_INTERACTIONS_BUTTON_TOOLTIP"
					tooltip_visible = "[Not(IsInteractionMenuOpenForCharacterWithFilter(Character.Self, 'accolade'))]"
					onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'accolade')]"
					button_icon = {
						alwaystransparent = yes
						parentanchor = center
						size = { 30 30 }
						texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
					}
					text_single = {
						parentanchor = bottom|hcenter
						position = { 0 3 }
						text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, 'accolade')]"
						default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
						background = {
							margin = { 5 0 }
							margin_top = -5
							using = Background_Area_Dark
						}
					}
				}
				expand = {}
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				margin_left = 55
				margin_right = 20
				widget = {
					datacontext = "[Accolade.GetAcclaimedKnight]"
					size = { 190 300 }
					allow_outside = yes
					portrait_body = {
						position = { 0 108 }
						allow_outside = yes
						blockoverride "portrait_texture" {
							portrait_texture = "[Character.GetPortrait( 'environment_body', 'camera_body', GetAccoladePose( Accolade.Self ), PdxGetWidgetScreenSize(PdxGuiWidget.Self ) )]"
							size = { 360 420 }
						}
						blockoverride "mask" {
							mask = "gfx/portraits/portrait_mask_council.dds"
						}
						blockoverride "position_portrait_opinion_body" {
							position = { 0 -108 }
						}
						blockoverride "coa" {
							coa_realm_medium_crown = {
								visible = "[And( Character.HasLandedTitles, Not( GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
								parentanchor = left|vcenter
								position = { -45 -13 }
							}
							coa_realm_medium_crown = {
								visible = "[And( Character.HasLandedTitles, GetScriptedGui( 'miv_accolade_artifact_enabled' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								parentanchor = left|vcenter
								position = { -45 0 }
							}
						}
						blockoverride "portrait_icons" {
							portrait_status_icons = {
								parentanchor = bottom|right
								position = { 0 -110 }
								background = {
									using = Background_Area_Dark
									margin = { 3 3 }
									alpha = 0.8
								}
							}
						}
					}
				}
				expand = {}
				vbox = {
					layoutpolicy_vertical = expanding
					margin_top = 15
					allow_outside = yes
					vbox = {
						spacing = 10
						allow_outside = yes
						vbox = {
							datamodel = "[Accolade.GetObtainedAccoladeTypes]"
							spacing = 10
							allow_outside = yes
							item = {
								hbox = {
									layoutpolicy_horizontal = expanding
									allow_outside = yes
									widget = {
										size = { 67 84 }
										allow_outside = yes
										text_label_right = {
											position = { -70 2 }
											parentanchor = top|right
											text = "[ObtainedAccoladeType.GetType.GetNameNoTooltip]"
											multiline = yes
										}
										icon = {
											datacontext = "[ObtainedAccoladeType.GetType.GetMaaUnlock]"
											visible = "[MenAtArmsType.IsValid]"
											texture = "[MenAtArmsType.GetIcon]"
											tooltipwidget = {
												widget_maa_type_container_tooltip = {
													blockoverride "maa_texture" {
														texture = "[MenAtArmsType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
													}
												}
											}
											size = { 30 30 }
											parentanchor = vcenter|left
											position = { -33 2 }
										}
										icon = {
											parentanchor = center
											size = { 64 80 }
											texture = "[ObtainedAccoladeType.GetType.GetIcon]"
											alwaystransparent = yes
											framesize = { 100 100 }
											tooltipwidget = {
												object_tooltip_pop_out = {
													blockoverride "title_text" {
														margin = { 0 8 }
														datacontext = "[ObtainedAccoladeType.GetType]"
														text = "[AccoladeType.GetName]"
														default_format = "#T"
													}
													blockoverride "concept_link" {
														text = "[accolade_type|E]"
													}
													blockoverride "description_text" {
														text = "OBTAINED_ACCOLADE_TYPE_TT"
													}
												}
											}
										}
										button_round = {
											allow_outside = yes
											parentanchor = top|right
											size = { 30 30 }
											position = { 10 -10 }
											visible = "[And( GreaterThan_int32( Accolade.GetAvailableLevelUpPoints, '(int32)0' ), LessThan_int32( ObtainedAccoladeType.GetLevel, '(int32)3') )]"
											onclick = "[AccoladeView.LevelUpAccoladeType( ObtainedAccoladeType.Self )]"
											tooltipwidget = {
												object_tooltip_pop_out = {
													blockoverride "title_text" {
														margin = { 0 8 }
														datacontext = "[ObtainedAccoladeType.GetType]"
														text = "[AccoladeType.GetName]"
														default_format = "#T"
													}
													blockoverride "concept_link" {
														text = "[accolade_type|E]"
													}
													blockoverride "description_text" {
														text = "UPGRADE_ACCOLADE_TYPE_TT"
													}
												}
											}
											button_select_arrow = {
												parentanchor = center
												size = { 20 20 }
												texture = "gfx/interface/icons/flat_icons/arrow_up.dds"
												alwaystransparent = yes
												state = {
													name = a
													next = b
													alpha = 0.4
													trigger_on_create = yes
													duration = 1.6
													using = Animation_Curve_Default
												}
												state = {
													name = b
													next = a
													alpha = 1
													duration = 0.8
													using = Animation_Curve_Default
												}
											}
										}
										flowcontainer = {
											parentanchor = center
											position = { 0 39 }
											ignoreinvisible = yes
											alwaystransparent = yes
											background = {
												texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
												spriteType = Corneredtiled
												spriteborder = { 40 8 }
												texture_density = 2
												margin = { 15 1 }
												modify_texture = {
													name = "mask"
													texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
													spriteType = Corneredstretched
													spriteborder = { 0 0 }
													blend_mode = alphamultiply
												}
											}
											icon_flat_standard_gold = {
												visible = "[GreaterThan_int32( ObtainedAccoladeType.GetLevel, '(int32)0' )]"
												size = { 15 15 }
												texture = "gfx/interface/icons/flat_icons/star.dds"
											}
											icon_flat_standard_gold = {
												visible = "[GreaterThan_int32( ObtainedAccoladeType.GetLevel, '(int32)1' )]"
												size = { 15 15 }
												texture = "gfx/interface/icons/flat_icons/star.dds"
											}
											icon_flat_standard_gold = {
												visible = "[GreaterThan_int32( ObtainedAccoladeType.GetLevel, '(int32)2' )]"
												size = { 15 15 }
												texture = "gfx/interface/icons/flat_icons/star.dds"
											}
											icon_flat_standard_ash = {
												visible = "[Not( GreaterThan_int32( ObtainedAccoladeType.GetLevel, '(int32)1' ) )]"
												size = { 15 15 }
												texture = "gfx/interface/icons/flat_icons/star.dds"
												modify_texture = {
													color = { 0 0 0 1 }
													blend_mode = multiply
													alpha = 0.4
												}
											}
											icon_flat_standard_ash = {
												visible = "[Not( GreaterThan_int32( ObtainedAccoladeType.GetLevel, '(int32)2' ) )]"
												size = { 15 15 }
												texture = "gfx/interface/icons/flat_icons/star.dds"
												modify_texture = {
													color = { 0 0 0 1 }
													blend_mode = multiply
													alpha = 0.4
												}
											}
										}
									}
								}
							}
						}
						hbox = {
							layoutpolicy_horizontal = expanding
							expand = {}
							button_standard = {
								visible = "[And( LessThan_int32(GetDataModelSize(Accolade.GetObtainedAccoladeTypes), GetDefine( 'NAccolade', 'ACCOLADE_MAX_TYPES') ), Or( And( GreaterThan_int32(Accolade.GetAvailableLevelUpPoints, '(int32)0'), GreaterThan_int32( Accolade.GetCurrentRankNumber, '(int32)5' ) ), GreaterThan_int32( Subtract_int32( Accolade.GetAvailableLevelUpPoints,  Accolade.GetCurrentRankNumber ), '(int32)-6') ) ) ]"
								size = { 67 84 }
								datacontext = "[Accolade]"
								tooltip = "ACCOLADE_ADD_NEW_TYPE_TT"
