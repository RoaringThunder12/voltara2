ansf_event_window = {
	name = "ansf_event_window"
}

types BigWindowTypes {
	type ansf_event_window = window {

		parentanchor = center
		widgetanchor = center
		allow_outside = yes

		size = { 1390 750 }

		layer = events

		datacontext = "[EventWindow.AccessEventWindowData]"

		using = Event_Window_Debug_EventTools
		blockoverride "is_event_on_top" {
			enabled = "[EventWindow.IsOnTop]"
		}
		blockoverride "is_event_on_top_close" {
			trigger_when = "[Not(EventWindow.IsOnTop)]"
		}

		block "transition" {
			alpha = 0

			state = {
				name = show
				trigger_on_create = yes
				using = Animation_FadeIn_Standard
				duration = 0.7

				on_start = "[GetVariableSystem.Clear( 'event_window_mouse_leave')]"

				start_sound = {
					soundeffect = "event:/SFX/Events/Panels/sfx_event_panel_large"

					soundparam = {
						name = StateChange
						value = 1
					}
				}
			}

			state = {
				name = _hide
				using = Animation_FadeOut_Standard
			}
		}
		state = {
			name = _mouse_hierarchy_leave
			on_start = "[GetVariableSystem.Set( 'event_window_mouse_leave', 'true' )]"
		}
		
		state = {
			name = reset_options
			duration = 0.1
			trigger_when = "[GetVariableSystem.Exists('reset_event_options')]"
			on_finish = "[EventWindow.ResetContents]"
			on_finish = "[GetVariableSystem.Toggle('reset_event_options')]"
		}

		event_window_dimmer_widget = {}

		#Event window frame
		block "window_decoration" {
			widget = {
				parentanchor = bottom|hcenter
				size = { 100% 100% }
				using = Window_Background
				using = Window_Decoration_Frontend_Flat
			}
		}
		
		#Background illustration
		event_window_background_widget = {

			block "background_widget_margins" {
				margin_left = 40
				margin_right = 40
				margin_top = 16
				margin_bottom = 20
			}

			state = {
				name = appear
				trigger_on_create = yes
				delay = 0.1
				using = Animation_Curve_Default
				alpha = 1
				duration = 0.5
			}

			blockoverride "event_mask" {}

			blockoverride "event_picture_properties" {
				using = Mask_Rough_Edges
			}
		}


		#Background VFX
		margin_widget = {
			name = "background_shader_vfx_container"
			position = { 30 20 }
			size = { 100% 100% }

			margin = { 30 20 }
		}

		###CHARACTERS
		widget = {
			name = "characters"
			parentanchor = top|hcenter
			position = { 0 34 }
			size = { 100% 100% }

			## LEFT CHARACTER ###
			widget = {
				name = "left_portrait_root_widget" # Used by code to do flexible portrait stacking
				size = { 300 650 }
				parentanchor = bottom|hcenter
				# Fixed position layout instead of hbox because then we can do different depth order portrait stacking
				position = "[Select_CVector2f( EventWindowData.HasPortraitCharacter('center_portrait'), '(CVector2f)-425,-50', Select_CVector2f( EventWindowData.HasPortraitCharacter('right_portrait'), '(CVector2f)-300,-50', '(CVector2f)0,-50' ) )]"

				allow_outside = no

				block "transition_left_character" {
					alpha = 0

					state = {
						name = appear
						trigger_on_create = yes
						delay = 0.2
						using = Animation_Curve_Default
						alpha = 1
						duration = 0.6
					}
				}

				portrait_event = {
					name = "portrait_left"
					datacontext = "[EventWindowData.GetPortraitCharacter('left_portrait')]"
					visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
					parentanchor = bottom|hcenter
					size = { 500 650 }

					blockoverride "portrait_button"
					{
						size = { 135% 135% }
						portrait_texture = "[EventWindowData.GetAnimatedEventPortraitTexture('left_portrait', 'camera_event_scheme_left', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
						alwaystransparent = "[Not(EventWindowData.ShouldShowPortraitInfo('left_portrait'))]"

						tooltip_visible = "[EventWindowData.ShouldShowPortraitInfo('left_portrait')]"
						tooltip_widgetanchor = center
						tooltip_offset = { 0 400 }
						using = tooltip_ws
					}

					blockoverride "highlight_visible"
					{
						visible = "[Or(Character.IsHovered, EventWindowData.IsCharacterHighlighted( EventWindowData.GetPortraitCharacter('left_portrait') ))]"
						position = { -40 0 }
					}

					blockoverride "grayscale" {}

					highlight_icon = {
						name = "prison_bars"
						visible = "[And(Character.IsImprisoned, Not(EventWindowData.ShouldHideImprisonment('left_portrait')))]"
						visible_at_creation = no
						parentanchor = bottom|left
						position = { 70 32 }
						size = { 340 100% }
						effectname = "NoHighlight"
						spriteType = corneredTiled
						texture_density = 1.5
						texture = "gfx/portraits/portrait_prison_body.dds"

						modify_texture = {
							name = "mask"
							texture =  "gfx/portraits/portrait_mask_event.dds"
							spriteType = Corneredstretched
							blend_mode = alphamultiply
						}
					}
				}
			}

			## CENTER CHARACTER ###
			widget = {
				name = "center_portrait_root_widget" # Used by code to do flexible portrait stacking
				size = { 300 650 }
				parentanchor = bottom|hcenter
				# Fixed position layout instead of hbox because then we can do different depth order portrait stacking
				position = { 0 -50 }

				allow_outside = no

				block "transition_center_character" {
					alpha = 0

					state = {
						name = appear
						trigger_on_create = yes
						delay = 0.4
						using = Animation_Curve_Default
						alpha = 1
						duration = 0.6
					}
				}
				portrait_event = {
					name = "portrait_center"
					datacontext = "[EventWindowData.GetPortraitCharacter('center_portrait')]"
					visible = "[EventWindowData.HasPortraitCharacter('center_portrait')]"
					parentanchor = bottom|hcenter
					size = { 500 650 }

					blockoverride "portrait_button"
					{
						size = { 135% 135% }
						portrait_texture = "[EventWindowData.GetAnimatedEventPortraitTexture('center_portrait', 'camera_event_scheme_left', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
						alwaystransparent = "[Not(EventWindowData.ShouldShowPortraitInfo('center_portrait'))]"

						tooltip_visible = "[EventWindowData.ShouldShowPortraitInfo('center_portrait')]"
						tooltip_widgetanchor = center
						using = tooltip_below
					}

					blockoverride "highlight_visible"
					{
						visible = "[Or(Character.IsHovered, EventWindowData.IsCharacterHighlighted( EventWindowData.GetPortraitCharacter('center_portrait') ))]"
						position = { -40 0 }
					}

					blockoverride "grayscale" {}

					highlight_icon = {
						name = "prison_bars"
						visible = "[And(Character.IsImprisoned, Not(EventWindowData.ShouldHideImprisonment('center_portrait')))]"
						visible_at_creation = no
						parentanchor = bottom|hcenter
						position = { -32 32 }
						size = { 340 100% }
						effectname = "NoHighlight"
						spriteType = corneredTiled
						texture_density = 1.5
						texture = "gfx/portraits/portrait_prison_body.dds"

						modify_texture = {
							name = "mask"
							texture =  "gfx/portraits/portrait_mask_event.dds"
							spriteType = Corneredstretched
							blend_mode = alphamultiply
						}
					}
				}
			}

			### RIGHT CHARACTER ###
			widget = {
				name = "right_portrait_root_widget" # Used by code to do flexible portrait stacking
				size = { 300 650 }
				parentanchor = bottom|hcenter
				# Fixed position layout instead of hbox because then we can do different depth order portrait stacking
				position = "[Select_CVector2f( EventWindowData.HasPortraitCharacter('center_portrait'), '(CVector2f)425,-50', Select_CVector2f( EventWindowData.HasPortraitCharacter('left_portrait'), '(CVector2f)300,-50', '(CVector2f)0,-50' ) )]"
				allow_outside = no

				block "transition_right_character" {
					alpha = 0

					state = {
						name = appear
						trigger_on_create = yes
						delay = 0.6
						using = Animation_Curve_Default
						alpha = 1
						duration = 0.6
					}
				}

				portrait_event = {
					name = "portrait_right"
					datacontext = "[EventWindowData.GetPortraitCharacter('right_portrait')]"
					visible = "[EventWindowData.HasPortraitCharacter('right_portrait')]"
					parentanchor = bottom|right
					size = { 500 650 }

					blockoverride "portrait_button"
					{
						size = { 135% 135% }
						portrait_texture = "[EventWindowData.GetAnimatedEventPortraitTexture('right_portrait', 'camera_event_scheme_right', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
						alwaystransparent = "[Not(EventWindowData.ShouldShowPortraitInfo('right_portrait'))]"

						tooltip_visible = "[EventWindowData.ShouldShowPortraitInfo('right_portrait')]"
						tooltip_offset = { -210 0 }
					}

					blockoverride "highlight_visible"
					{
						visible = "[Or(Character.IsHovered, EventWindowData.IsCharacterHighlighted( EventWindowData.GetPortraitCharacter('right_portrait') ))]"
						position = { 80 0 }
					}

					blockoverride "grayscale" {}

					highlight_icon = {
						name = "prison_bars"
						visible = "[And(Character.IsImprisoned, Not(EventWindowData.ShouldHideImprisonment('right_portrait')))]"
						visible_at_creation = no
						parentanchor = bottom|right
						position = { -30 32 }
						size = { 340 100% }
						effectname = "NoHighlight"
						spriteType = corneredTiled
						texture_density = 1.5
						texture = "gfx/portraits/portrait_prison_body.dds"

						modify_texture = {
							name = "mask"
							texture =  "gfx/portraits/portrait_mask_event.dds"
							spriteType = Corneredstretched
							blend_mode = alphamultiply
						}
					}
				}
			}
		}

		#Fade for Readability
		icon = {
			size = { 97% 75% }
			parentanchor = bottom|hcenter
			position = { 0 -17 }
			texture = "gfx/interface/colors/black.dds"
			alpha = 0.5

			using = Mask_Rough_Edges

			modify_texture = {
				blend_mode = alphaMultiply
				texture = "gfx/interface/component_masks/mask_fade_vertical_up.dds"
			}
		}

		# Event Effect Video
		event_window_effect_2d_widget = {
			margin = { 40 20 }
		}

		#Foreground VFX
		margin_widget = {
			name = "foreground_shader_vfx_container"
			position = { 30 20 }
			size = { 100% 100% }
			margin = { 36 20 }
		}

		# Event description and options
		vbox = {
			name = "event_content_container"
			layoutpolicy_vertical = expanding
			margin_left = 16
			margin_right = 60
			margin_bottom = 20

			block "transition_text" {
				alpha = 0

				state = {
					name = appear
					trigger_on_create = yes
					delay = 0.8
					using = Animation_Curve_Default
					alpha = 1
					duration = 0.6
				}
			}

			expand = {}

			hbox = {
				name = "description_and_options"
				layoutpolicy_horizontal = expanding

				state = {
					name = appear
					trigger_on_create = yes
					delay = 0.2
					using = Animation_Curve_Default
					alpha = 1
					duration = 1.5
				}

				background = {
					using = Background_Area_ExtraDark
					margin_left = -23
					margin_right = 23
					margin_bottom = 2

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
					}
				}

				vbox = {
					name = "description_container"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					scrollarea = {
						name = "description_scrollarea"
						size = { 720 300 }

						scrollbarpolicy_horizontal = always_off

						scrollbar_vertical = {
							using = Scrollbar_Vertical

							blockoverride "alpha"{
								alpha = 0.6
							}
						}

						scrollwidget = {
							vbox = {
								parentanchor = bottom
								layoutpolicy_vertical = expanding
								visible = "[Not(GetPlayer.MakeScope.Var('show_ansf_regenerate_window').IsSet)]"

								expand = {}

								hbox = {
									layoutpolicy_horizontal = expanding

									text_multi = {
										name = "description"
										layoutpolicy_horizontal = expanding
										max_width = 380
										text = "[EventWindowData.GetDescription]"
										autoresize = yes
										fontsize = 16

										margin = { 0 15 }
										margin_left = 20

										background = {
											using = Background_Area_ExtraDark
											margin_top = 40
											margin_right = 100
											margin_left = 2
											alpha = 0.8

											modify_texture = {
												texture = "gfx/interface/component_masks/mask_fade_horizontal_extended.dds"
												blend_mode = alphamultiply
											}

											modify_texture = {
												texture = "gfx/interface/component_masks/mask_fade_vertical_short.dds"
												blend_mode = alphamultiply
											}

											modify_texture = {
												texture = "gfx/interface/component_masks/mask_fade_textured_vertical_down.dds"
												texture_density = 4
												blend_mode = alphamultiply
												spriteType = corneredTiled
												spriteborder_top = 55
											}
										}
									}

									expand = {}
								}
							}
						}
					}
				}

				vbox = {
					name = "options_container"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					allow_outside = yes
					ignoreinvisible = yes

					margin_bottom = 15
					spacing = 5

					expand = {}

					hbox = {
						spacing = 5

						hbox = {
							name = "dynamic_birth_name"
							margin = { 5 30 }
						}
					}

					vbox = {
						name = "custom_widgets_container"
						alpha = 0
						margin = { 15 0 }
						layoutpolicy_horizontal = expanding

						state = {
							trigger_on_create = yes
							name = appear_test
							delay = 0.8
							using = Animation_Curve_Default
							alpha = 1
							duration = 0.6
						}
					}

					fixedgridbox = {
						name = "option_grid"
						addcolumn = 500
						addrow = 42
						datamodel = "[EventWindowData.GetOptions]"

						item = {
							button_eventoption = {}
						}
					}
				}
			}
		}

		widget = {
			name = "bottom_characters"
			position = { -64 64}
			size = { 140 100% }
			parentanchor = top|right
			datacontext = "[EventWindowData.GetArtifact('lower_left_portrait')]"

			visible = "[Or( Or( Or( Or( EventWindowData.HasArtifact('lower_left_portrait'), EventWindowData.HasArtifact('lower_center_portrait') ), Or( EventWindowData.HasArtifact('lower_right_portrait'), EventWindowData.HasPortraitCharacter('lower_left_portrait') ) ), EventWindowData.HasPortraitCharacter('lower_center_portrait') ), EventWindowData.HasPortraitCharacter('lower_right_portrait') )]"

			vbox = {
				margin = { 16 24 }

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes

					flowcontainer = {
						datacontext = "[EventWindowData.GetArtifact('lower_left_portrait')]"
						visible = "[EventWindowData.HasArtifact('lower_left_portrait')]"
						direction = vertical
						spacing = -5
						margin_bottom = 20
						using = artifact_event_flowcontainer
					}

					widget = {
						datacontext = "[EventWindowData.GetPortraitCharacter('lower_left_portrait')]"
						visible = "[EventWindowData.HasPortraitCharacter('lower_left_portrait')]"
						size = { 140 150 }

						portrait_event_small = {
							name = "portrait_left_small_1"
							parentanchor = center
							position = { 0 -4 }

							blockoverride "portrait_button"
							{
								portrait_texture = "[EventWindowData.GetStaticEventPortraitTexture('lower_left_portrait', 'camera_shoulders', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
								alwaystransparent = "[Not(EventWindowData.ShouldShowPortraitInfo('lower_left_portrait'))]"
								tooltip_visible = "[EventWindowData.ShouldShowPortraitInfo('lower_left_portrait')]"
							}

							blockoverride "highlight_visible"
							{
								visible = "[Or(Character.IsHovered, EventWindowData.IsCharacterHighlighted( EventWindowData.GetPortraitCharacter('lower_left_portrait') ))]"
							}

							blockoverride "status_icons" {}
							
							blockoverride "dead_icon"
							{

							}
							blockoverride "opinion_box" {}
							blockoverride "grayscale" {}

							blockoverride "coa"
							{
								flowcontainer = {
									visible = "[EventWindowData.ShouldShowPortraitInfo('lower_left_portrait')]"
									parentanchor = bottom
									position = { -15 -28 }
									spacing = -10
									ignoreinvisible = yes

									coa_realm_small_crown = {
										visible = "[Character.HasLandedTitles]"
										parentanchor = bottom
										scale = 0.8
									}

									icon = {
										name = "is_dead"
										visible = "[Character.IsDeadAndValid]"
										parentanchor = bottom
										size = { 20 20 }

										texture = "[Character.GetDeathReasonIcon]"
										tooltip = "CHARACTER_DEAD_TOOLTIP"
									}
								}
							}

							text_label_center = {
								parentanchor = bottom|hcenter
								alwaystransparent = yes
								text = "[Character.GetShortUINameNoTooltip]"
								visible = "[EventWindowData.ShouldShowPortraitInfo('lower_left_portrait')]"
								max_width = 115
								align = center
								fontsize_min = 12
							}
						}
					}
				}

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes

					flowcontainer = {
						datacontext = "[EventWindowData.GetArtifact('lower_center_portrait')]"
						visible = "[EventWindowData.HasArtifact('lower_center_portrait')]"
						direction = vertical
						spacing =-5
						margin_bottom = 20
						using = artifact_event_flowcontainer
					}

					widget = {
						datacontext = "[EventWindowData.GetPortraitCharacter('lower_center_portrait')]"
						visible = "[EventWindowData.HasPortraitCharacter('lower_center_portrait')]"
						size = { 140 150 }

						portrait_event_small = {
							name = "portrait_left_small_2"
							parentanchor = center
							position = { 0 -4 }

							blockoverride "portrait_button"
							{
								portrait_texture = "[EventWindowData.GetStaticEventPortraitTexture('lower_center_portrait', 'camera_shoulders', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
								alwaystransparent = "[Not(EventWindowData.ShouldShowPortraitInfo('lower_center_portrait'))]"
								tooltip_visible = "[EventWindowData.ShouldShowPortraitInfo('lower_center_portrait')]"
							}

							blockoverride "highlight_visible"
							{
								visible = "[Or(Character.IsHovered, EventWindowData.IsCharacterHighlighted( EventWindowData.GetPortraitCharacter('lower_center_portrait') ))]"
							}

							blockoverride "status_icons" {}
							blockoverride "opinion_box"{}
							blockoverride "grayscale" {}

							blockoverride "coa"
							{
								flowcontainer = {
									visible = "[EventWindowData.ShouldShowPortraitInfo('lower_center_portrait')]"
									parentanchor = bottom
									position = { -15 -28 }
									spacing = -10
									ignoreinvisible = yes

									coa_realm_small_crown = {
										visible = "[Character.HasLandedTitles]"
										parentanchor = bottom
										scale = 0.8
									}

									icon = {
										name = "is_dead"
										visible = "[Character.IsDeadAndValid]"
										parentanchor = bottom
										size = { 20 20 }

										texture = "[Character.GetDeathReasonIcon]"
										tooltip = "CHARACTER_DEAD_TOOLTIP"
									}
								}
							}


							text_label_center = {
								parentanchor = bottom|hcenter
								alwaystransparent = yes
								text = "[Character.GetShortUINameNoTooltip]"
								visible = "[EventWindowData.ShouldShowPortraitInfo('lower_center_portrait')]"
								max_width = 115
								align = center
								fontsize_min = 12
							}
						}
					}
				}

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes

					flowcontainer = {
						datacontext = "[EventWindowData.GetArtifact('lower_right_portrait')]"
						visible = "[EventWindowData.HasArtifact('lower_right_portrait')]"
						direction = vertical
						spacing =-5
						margin_bottom = 20
						using = artifact_event_flowcontainer
					}

					widget = {
						datacontext = "[EventWindowData.GetPortraitCharacter('lower_right_portrait')]"
						visible = "[EventWindowData.HasPortraitCharacter('lower_right_portrait')]"
						size = { 140 150 }

						portrait_event_small = {
							name = "portrait_right_small_1"
							parentanchor = center
							position = { 0 -4 }

							blockoverride "portrait_button"
							{
								portrait_texture = "[EventWindowData.GetStaticEventPortraitTexture('lower_right_portrait', 'camera_shoulders', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
								alwaystransparent = "[Not(EventWindowData.ShouldShowPortraitInfo('lower_right_portrait'))]"
								tooltip_visible = "[EventWindowData.ShouldShowPortraitInfo('lower_right_portrait')]"
							}

							blockoverride "portrait_transformation"
							{
								portrait_scale = { -1 1 }
								portrait_offset = { 1 0 }
							}

							blockoverride "highlight_visible"
							{
								visible = "[Or(Character.IsHovered, EventWindowData.IsCharacterHighlighted( EventWindowData.GetPortraitCharacter('lower_right_portrait') ))]"
							}

							blockoverride "status_icons"{}
							blockoverride "opinion_box"{}
							blockoverride "grayscale" {}

							blockoverride "coa"
							{
								flowcontainer = {
									visible = "[EventWindowData.ShouldShowPortraitInfo('lower_right_portrait')]"
									parentanchor = bottom
									position = { -15 -28 }
									spacing = -10
									ignoreinvisible = yes

									coa_realm_small_crown = {
										visible = "[Character.HasLandedTitles]"
										parentanchor = bottom
										scale = 0.8
									}

									icon = {
										name = "is_dead"
										visible = "[Character.IsDeadAndValid]"
										parentanchor = bottom
										size = { 20 20 }

										texture = "[Character.GetDeathReasonIcon]"
										tooltip = "CHARACTER_DEAD_TOOLTIP"
									}
								}
							}

							text_label_center = {
								parentanchor = bottom|hcenter
								alwaystransparent = yes
								text = "[Character.GetShortUINameNoTooltip]"
								visible = "[EventWindowData.ShouldShowPortraitInfo('lower_right_portrait')]"
								max_width = 115
								align = center
								fontsize_min = 12
							}
						}
					}
				}
				expand = {}
			}
		}

		### HEADER ###
		block "event_header" {

			widget = {
				size = { 1390 76 }

				widget = {
					size = { 100% 57 }
					position = { 0 17 }

					icon = {
						name = "theme_header"
						position = { 24 0 }
						size = { 1072 57 }
						texture = "[EventWindowData.GetThemeHeaderWide]"

						modify_texture = {
							name = overlay
							texture = "gfx/interface/component_effects/effect_header_blue_shine.dds"
							blend_mode = colordodge
							translate_uv = { 0.6 0 }
						}

						state = {
							name = right
							next = left

							duration = 8
							bezier = { 0.8 0.18 0.96 .05 }

							modify_texture = {
								name = overlay
								translate_uv = { -0.6 0 }
							}
						}

						state = {
							name = left
							next = right

							duration = 0.0
							delay = 5

							modify_texture = {
								name = overlay
								translate_uv = { 0.6 0 }
							}
						}

						state = {
							trigger_on_create = yes
							name = start
							next = right

							duration = 0.0

							modify_texture = {
								name = overlay
								translate_uv = { 0.6 0 }
							}
						}
					}

					text_single = {
						name = "title"
						position = { 128 1 }
						fontsize = 29
						fontsize_min = 16
						text = "[EventWindowData.GetTitle]"
						default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
						using = Font_Type_Flavor
						max_width = 950

						alpha = 0

						state = {
							name = start
							trigger_on_create = yes
							delay = 0.2
							using = Animation_Curve_Default
							alpha = 1
							duration = 0.5
						}
					}

					icon = {
						name = "theme_icon"
						position = { 28 -19 }
						size = { 90 90 }
						texture = "[EventWindowData.GetThemeIcon]"

						modify_texture = {
							name = overlay
							texture = "gfx/interface/component_effects/effect_blue_shine.dds"
							blend_mode = colordodge
							translate_uv = { 0.6 0 }
						}

						state = {
							name = right
							next = left

							duration = 2
							bezier = { .8 .18 .96 .05 }

							modify_texture = {
								name = overlay
								translate_uv = { -0.6 0 }
							}
						}

						state = {
							name = left
							next = right

							duration = 0.0
							delay = 5


							modify_texture = {
								name = overlay
								translate_uv = { 0.6 0 }
							}
						}

						state = {
							trigger_on_create = yes
							name = start
							next = right

							duration = 0.0

							modify_texture = {
								name = overlay
								translate_uv = {0.6 0}
							}
						}

					}

					icon = {
						visible = "[And( EventWindowData.ShouldShowContentSource, EventWindowData.GetContentSourceDlc.HasEventDecoration )]"
						name = "source_icon"
						position = { -22 20 }
						size = { 263 64 }
						parentanchor = top|right
						texture = "[EventWindowData.GetContentSourceDlc.GetEventDecoration]"
						tooltip = "EVENT_CONTENT_SOURCE_TT"
						alpha = 1
					}
				}
			}
		}

		flowcontainer = {
			name = "debug_stuff"
			#visible = no
			visible = "[InDebugMode]"
			parentanchor = top|right
			position = { -100 25 }
			ignoreinvisible = yes

			using = Event_Window_Debug_Info
		}
		
		widget = {
			size = { 0 100% }
			position = { -50 0 }
			parentanchor = right
			allow_outside = yes
			alwaystransparent = yes

			using = Event_Window_Right_Tooltips
		}
	
		### SET PARAMETERS INTERFACE ###
		window = {
			name = "ansf_regenerate"
			parentanchor = top|left
			position = { 80 100 }
			minimumsize = { 400 250 }
			layer = events
			filter_mouse = all
			allow_outside = yes
			alwaystransparent = no
			
			using = Window_Decoration
			
			visible = "[GetPlayer.MakeScope.Var('show_ansf_regenerate_window').IsSet]"
			
			datacontext = "[GetVariableSystem]"
			datacontext = "[GetPlayer]"
			
			state = {
				name = _show
				using = Animation_FadeIn_Standard
				on_finish = "[PdxGuiWidget.StackTop]"
			}
			
			state = {
				name = _hide
				using = Animation_FadeOut_Standard
			}
			
			vbox = {
				margin_left = 30
				margin_right = 30
				margin_bottom = 30
				margin_top = 20
				ignoreinvisible = yes
				
				using = Window_Background
				
				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = ansf_character_generation
					}

					blockoverride "button_close"
					{
						size = { 20 20 }
						onclick = "[GetScriptedGui('toggle_ansf_regenerate_window').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_close"
					}
				}
				
				hbox = {
					hbox = {
						spacing = 5
						margin = { 10 0 }
						margin_bottom = 10

						button_round = {
							size = { 28 28 }
							visible = "[Not(GetPlayer.MakeScope.Var('ansf_family_character_cannot_change_age').IsSet)]"
							enabled = "[GetScriptedGui('ansf_can_lower_age').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('ansf_can_lower_age').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							button_minus_small = {
								name = "decrease_age"
								parentanchor = center
								alwaystransparent = yes
							}
						}

						text_single = {
							name = "increment"
							visible = "[Not(GetPlayer.MakeScope.Var('ansf_family_character_randomize_age').IsSet)]"
							text = ansf_character_age_increment
							tooltip = ansf_character_age_increment_tt
						}
						
						text_single = {
							name = "randomized"
							visible = "[GetPlayer.MakeScope.Var('ansf_family_character_randomize_age').IsSet]"
							text = ansf_character_age_random
							tooltip = ansf_character_age_random_tt
						}

						button_round = {
							size = { 28 28 }
							visible = "[Not(GetPlayer.MakeScope.Var('ansf_family_character_cannot_change_age').IsSet)]"
							enabled = "[GetScriptedGui('ansf_can_raise_age').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('ansf_can_raise_age').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							button_plus_small = {
								name = "increase_age"
								parentanchor = center
								alwaystransparent = yes
							}
						}
						
						vbox = {
							margin_left = 20
							button_checkbox_label = {
								layoutpolicy_horizontal = expanding
								onclick = "[GetScriptedGui('ansf_randomize_age').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[Not(GetPlayer.MakeScope.Var('ansf_family_character_cannot_change_age').IsSet)]"
								
								blockoverride "checkbox" 
								{
									size = { 25 25 }
									checked = "[GetPlayer.MakeScope.Var('ansf_family_character_randomize_age').IsSet]"
								}
								
								blockoverride "text"
								{
									text = ansf_random_age_setting
									tooltip = ansf_random_age_setting_tt
								}
							}
						}
					}
				}
				
				widget = {
					size = { 240 210 }

					visible = "[Not(GetPlayer.MakeScope.Var('ansf_cannot_change_education').IsSet)]"

					vbox = {
						name = "court_char_spawner_selection_panel"
						restrictparent_min = yes
						
						scrollbox = {
							name = "char_spawner_councillor_scrollbox"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							size = { -1 0 }

							blockoverride "scrollbox_content" {
								button_standard_hover = {
									name = char_spawner_martial_button
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									onclick = "[GetScriptedGui('ansf_family_martial_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									hbox = {
										margin = { 5 0 }
										margin_right = 10
										spacing = 10
				
										icon = {
											size = { 30 30 }
											texture = "gfx/interface/icons/traits/education_martial_base.dds"
										}
										
										background = {
											name = "interaction_glow"
											visible = "[GetPlayer.MakeScope.Var('ansf_family_character_education_martial').IsSet]"
											texture = "gfx/interface/component_tiles/tile_selected.dds"
											spriteType = corneredtiled
											spriteborder = { 30 30 }
										}
				
										text_single = {
											layoutpolicy_horizontal = expanding
											text = ansf_martial_education
											default_format = "#clickable"
										}
									}
								}
								
								button_standard_hover = {
									name = char_spawner_diplomacy_button
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									onclick = "[GetScriptedGui('ansf_family_diplomacy_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									hbox = {
										margin = { 5 0 }
										margin_right = 10
										spacing = 10
				
										icon = {
											size = { 30 30 }
											texture = "gfx/interface/icons/traits/education_diplomacy_base.dds"
										}
										
										background = {
											name = "interaction_glow"
											visible = "[GetPlayer.MakeScope.Var('ansf_family_character_education_diplomacy').IsSet]"
											texture = "gfx/interface/component_tiles/tile_selected.dds"
											spriteType = corneredtiled
											spriteborder = { 30 30 }
										}
				
										text_single = {
											layoutpolicy_horizontal = expanding
											text = ansf_diplomacy_education
											default_format = "#clickable"
										}
									}
								}
								
								button_standard_hover = {
									name = char_spawner_stewardship_button
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									onclick = "[GetScriptedGui('ansf_family_stewardship_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									hbox = {
										margin = { 5 0 }
										margin_right = 10
										spacing = 10
				
										icon = {
											size = { 30 30 }
											texture = "gfx/interface/icons/traits/education_stewardship_base.dds"
										}
										
										background = {
											name = "interaction_glow"
											visible = "[GetPlayer.MakeScope.Var('ansf_family_character_education_stewardship').IsSet]"
											texture = "gfx/interface/component_tiles/tile_selected.dds"
											spriteType = corneredtiled
											spriteborder = { 30 30 }
										}
				
										text_single = {
											layoutpolicy_horizontal = expanding
											text = ansf_stewardship_education
											default_format = "#clickable"
										}
									}
								}
								
								button_standard_hover = {
									name = char_spawner_intrigue_button
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									onclick = "[GetScriptedGui('ansf_family_intrigue_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									hbox = {
										margin = { 5 0 }
										margin_right = 10
										spacing = 10
				
										icon = {
											size = { 30 30 }
											texture = "gfx/interface/icons/traits/education_intrigue_base.dds"
										}
										
										background = {
											name = "interaction_glow"
											visible = "[GetPlayer.MakeScope.Var('ansf_family_character_education_intrigue').IsSet]"
											texture = "gfx/interface/component_tiles/tile_selected.dds"
											spriteType = corneredtiled
											spriteborder = { 30 30 }
										}
				
										text_single = {
											layoutpolicy_horizontal = expanding
											text = ansf_intrigue_education
											default_format = "#clickable"
										}
									}
								}
								
								button_standard_hover = {
									name = char_spawner_learning_button
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									onclick = "[GetScriptedGui('ansf_family_learning_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									hbox = {
										margin = { 5 0 }
										margin_right = 10
										spacing = 10
				
										icon = {
											size = { 30 30 }
											texture = "gfx/interface/icons/traits/education_learning_base.dds"
										}
										
										background = {
											name = "interaction_glow"
											visible = "[GetPlayer.MakeScope.Var('ansf_family_character_education_learning').IsSet]"
											texture = "gfx/interface/component_tiles/tile_selected.dds"
											spriteType = corneredtiled
											spriteborder = { 30 30 }
										}
				
										text_single = {
											layoutpolicy_horizontal = expanding
											text = ansf_learning_education
											default_format = "#clickable"
										}
									}
								}
								
								button_standard_hover = {
									name = char_education_randomize_button
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									onclick = "[GetScriptedGui('ansf_family_randomize_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									hbox = {
										margin = { 8 0 }
										margin_right = 10
										spacing = 10
				
										button_checkbox = {
											size = { 25 25 }
											checked = "[GetPlayer.MakeScope.Var('ansf_family_character_education_random').IsSet]"
										}
				
										text_single = {
											margin_left = 2
											layoutpolicy_horizontal = expanding
											text = ansf_randomize_education
											default_format = "#clickable"
										}
									}
								}
							}
						}
					}
				}
				
				vbox = {
					margin_top = 20
					spacing = 10
					layoutpolicy_horizontal = expanding
					ignoreinvisible = yes
					
					vbox = {
						layoutpolicy_vertical = expanding
						spacing = 10
						
						button_checkbox_label = {
							layoutpolicy_horizontal = expanding
							onclick = "[GetScriptedGui('ansf_make_character_clone').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							visible = "[And( Not(GetPlayer.MakeScope.Var('ansf_family_character_cannot_be_clone').IsSet), Not(GetPlayer.MakeScope.Var('ansf_family_character_must_be_clone').IsSet) )]"
							
							blockoverride "checkbox" 
							{
								size = { 25 25 }
								checked = "[GetPlayer.MakeScope.Var('ansf_family_character_is_clone').IsSet]"
							}
							
							blockoverride "text"
							{
								text = ansf_make_clone_setting
							}
						}
						
						button_checkbox_label = {
							layoutpolicy_horizontal = expanding
							onclick = "[GetScriptedGui('ansf_make_character_lowborn').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							visible = "[GetPlayer.MakeScope.Var('ansf_can_set_lowborn_status').IsSet]"
							
							blockoverride "checkbox" 
							{
								size = { 25 25 }
								checked = "[GetPlayer.MakeScope.Var('ansf_must_be_lowborn').IsSet]"
							}
							
							blockoverride "text"
							{
								text = ansf_make_lowborn_setting
							}
						}
						
						button_checkbox_label = {
							layoutpolicy_horizontal = expanding
							onclick = "[GetScriptedGui('ansf_make_character_not_lowborn').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							visible = "[GetPlayer.MakeScope.Var('ansf_can_set_lowborn_status').IsSet]"
							
							blockoverride "checkbox" 
							{
								size = { 25 25 }
								checked = "[GetPlayer.MakeScope.Var('ansf_must_not_be_lowborn').IsSet]"
							}
							
							blockoverride "text"
							{
								text = ansf_make_not_lowborn_setting
							}
						}
						
						button_checkbox_label = {
							layoutpolicy_horizontal = expanding
							onclick = "[GetScriptedGui('ansf_use_father_dna_effect').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							visible = "[GetPlayer.MakeScope.Var('ansf_family_character_can_use_parent_dna').IsSet]"
							
							blockoverride "checkbox" 
							{
								size = { 25 25 }
								checked = "[GetPlayer.MakeScope.Var('ansf_family_character_use_father_dna').IsSet]"
							}
							
							blockoverride "text"
							{
								text = ansf_make_father_clone_setting
							}
						}
						
						button_checkbox_label = {
							layoutpolicy_horizontal = expanding
							onclick = "[GetScriptedGui('ansf_use_mother_dna_effect').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							visible = "[GetPlayer.MakeScope.Var('ansf_family_character_can_use_parent_dna').IsSet]"
							
							blockoverride "checkbox" 
							{
								size = { 25 25 }
								checked = "[GetPlayer.MakeScope.Var('ansf_family_character_use_mother_dna').IsSet]"
							}
							
							blockoverride "text"
							{
								text = ansf_make_mother_clone_setting
							}
						}
						
						button_checkbox_label = {
							layoutpolicy_horizontal = expanding
							onclick = "[GetScriptedGui('ansf_make_character_different').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							visible = "[GetPlayer.MakeScope.Var('ansf_family_character_is_existing_dynasty').IsSet]"
							enabled = "[Not(GetPlayer.MakeScope.Var('ansf_family_character_cannot_be_different').IsSet)]"
							
							blockoverride "checkbox" 
							{
								size = { 25 25 }
								checked = "[GetPlayer.MakeScope.Var('ansf_family_character_is_different').IsSet]"
							}
							
							blockoverride "text"
							{
								text = ansf_make_different_setting
							}
						}
						
						expand = {}
					}
					
					button_standard = {
						size = { 250 35 }
						text = ansf_no_template_setting
						tooltip = ansf_change_template_tt
						onclick = "[GetScriptedGui('ansf_change_existing_template').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[GetVariableSystem.Toggle( 'template_dropdown' )]"
						visible = "[And( GetPlayer.MakeScope.Var('ansf_has_culture_faith_template').IsSet, Not( GetPlayer.MakeScope.Var('culture_faith_template').IsSet ) )]"
					}
					
					button_standard = {
						size = { 250 35 }
						text = ansf_has_template_setting
						tooltip = ansf_change_template_tt
						onclick = "[GetScriptedGui('ansf_change_existing_template').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[GetVariableSystem.Toggle( 'template_dropdown' )]"
						visible = "[And( GetPlayer.MakeScope.Var('ansf_has_culture_faith_template').IsSet, GetPlayer.MakeScope.Var('culture_faith_template').IsSet )]"
					}
					
					# Culture / Faith setting
					widget = {
						size = { 300 150 }
						
						visible = "[GetVariableSystem.Exists( 'template_dropdown')]"
						
						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							restrictparent_min = yes
							ignoreinvisible = yes
						
							scrollbox = {
								name = "template_list"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
								
								blockoverride "scrollbox_margins"
								{
									margin = { 30 0 }
								}

								blockoverride "scrollbox_content"
								{
								
									button_standard_hover = {
										name = randomize_button
										layoutpolicy_horizontal = expanding
										size = { 0 27 }
										onclick = "[GetScriptedGui('ansf_randomize_template').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										onclick = "[GetVariableSystem.Toggle( 'template_dropdown' )]"

										hbox = {
											margin = { 10 0 }
											spacing = 5
					
											icon = {
												size = { 30 30 }
												texture = "gfx/interface/icons/symbols/icon_cross.dds"
											}
					
											text_single = {
												margin_left = 2
												layoutpolicy_horizontal = expanding
												text = ansf_set_randomize_template
												default_format = "#clickable"
											}
										}
									}
								
									vbox_ansf_template = {
										layoutpolicy_horizontal = expanding
										datamodel = "[GetGlobalList('culture_faith_template')]"
									}
								}
							}
						}
					}
					
					# Bottom box: Use These Settings / Ready to Generate
					hbox = {
						margin_top = 10
						
						button_standard = {
							text = ansf_character_use_settings
							tooltip = ansf_character_use_settings_tt
							onclick = "[GetScriptedGui('ansf_use_changed_settings').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetVariableSystem.Toggle('reset_event_options')]"
							visible = "[Not(GetPlayer.MakeScope.Var('ansf_family_character_generate').IsSet)]"
							
							animation_glow_event = {
								name = "special_option"
							}
							
							state = {
								trigger_on_create = yes

								name = max_glow
								next = min_glow
								duration = 0.4
								using = Animation_Curve_Default

								glow_alpha = 3.0
							}

							state = {
								name = min_glow
								next = max_glow
								duration = 0.2
								using = Animation_Curve_Default

								glow_alpha = 0.5
							}
						}
						
						button_standard = {
							text = ansf_character_used_settings
							tooltip = ansf_character_used_settings_tt
							onclick = "[GetScriptedGui('ansf_use_changed_settings').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetVariableSystem.Toggle('reset_event_options')]"
							visible = "[GetPlayer.MakeScope.Var('ansf_family_character_generate').IsSet]"
							down = "[GetPlayer.MakeScope.Var('ansf_family_character_generate').IsSet]"
						}
					}
					
					expand = {}
				}
				
				expand = {}
			}
		}
	
	}
}

types ansf_template_menu_types
{

	type vbox_ansf_template = vbox
	{

		item = {
			hbox = {
				datacontext = "[Scope.GetCharacter]"
				layoutpolicy_horizontal = expanding
				block "test_visible"
				{
					visible = yes
				}
				button_standard_hover = {
					name = "template_item"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					size = { 0 27 }
					onclick = "[GetScriptedGui('ansf_set_new_template').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selection', Character.MakeScope).End)]"
					onclick = "[GetVariableSystem.Toggle( 'template_dropdown' )]"
					button_ignore = none

					hbox = {
						margin = { 10 0 }

						text_single = {
							layoutpolicy_horizontal = expanding
							text = ansf_template_entry
							default_format = "#clickable"
						}
					}
				}
			}
		}
	}
}


